# Clinical Interview Simulation — Environment Variables
# Copy this file to .env and fill in your values.

# LLM API (阿里百炼 DashScope)
# NOTE: both models must be NON-reasoning. agent/llm_client.py reads only
# message.content, so a "thinking" model burns its budget on reasoning and
# returns empty content.
# Reasoning (do NOT use): deepseek-v4.1-flash, deepseek-v4-pro-0813, qwen3.7-*, qwen3.5-flash/plus
# Non-reasoning (safe):    qwen-turbo, qwen-plus, qwen-max, qwen-flash, qwen-long
LLM_API_KEY=your_dashscope_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_PRO=qwen-plus
LLM_MODEL_LITE=qwen-turbo

# Database
# CWD-relative: run the backend from backend/ or a second empty DB appears at the repo root.
DATABASE_URL=sqlite:///./data/app.db

# Auth
SECRET_KEY=change-me-to-a-random-string
